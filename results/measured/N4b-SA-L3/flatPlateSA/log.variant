default         bounded dualTime rPseudoDeltaT steadyState;
startFrom       startTime;
startTime       0;
endTime         800;
deltaT          1;
writeControl    timeStep;
writeInterval   1000000;
functions
{
    gncState
    {
        type            gncHisaDump;
        libs            ( "/ssd/sclin/gpu-native-cfd/build/lib/libgncHisaDump.so" );
        outputDir       "/ssd/sclin/gpu-native-cfd/runs/N4b-SA-L3/flatPlateSA/ref/state";
        fields          ( p T U e thermo:psi thermo:mu thermo:alpha rho rhoU rhoE phi pseudoCoDamping pseudoCoNum nuTilda k omega nut alphat );
        timeIndices     ( 1 2 10 100 400 800 );
        atEnd           true;
    }
}
