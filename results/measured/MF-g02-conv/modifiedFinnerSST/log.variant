default         bounded dualTime rPseudoDeltaT steadyState;
startFrom       startTime;
startTime       0;
endTime         1000;
deltaT          1;
writeControl    timeStep;
writeInterval   1000;
writePrecision  17;
functions
{
    forces
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( body fin1 fin2 fin3 fin4 );
        rho             rho;
        log             off;
        writeControl    timeStep;
        writeInterval   1;
        CofR            ( -0.144 0 0 );
    }
}
executeControl  timeStep;
executeInterval 1;
writeControl    timeStep;
writeInterval   1;
log             off;
forces=forces
