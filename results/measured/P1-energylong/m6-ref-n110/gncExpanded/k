//
// "0/k"
//
FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          k;
}

dimensions      [ 0 2 -2 0 0 0 0 ];

internalField   uniform 26;

boundaryField
{
    wing
    {
        type            kqRWallFunction;
        value           uniform 9.9999999999999994e-12;
    }
    "(farfield)"
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.01;
        value           uniform 26;
    }
    "(symm)"
    {
        type            symmetry;
        value           uniform 0;
    }
    "(intPatch)"
    {
        type            zeroGradient;
    }
}
