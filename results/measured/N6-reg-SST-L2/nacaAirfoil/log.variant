method          meshWave;
default         bounded dualTime rPseudoDeltaT steadyState;
startFrom       startTime;
startTime       0;
endTime         10;
deltaT          1;
writeControl    timeStep;
writeInterval   1000000;
functions
{
    gncState
    {
        type            gncHisaDump;
        libs            ( "/ssd/sclin/gpu-native-cfd/build/lib/libgncHisaDump.so" );
        outputDir       "/ssd/sclin/gpu-native-cfd/runs/N6-reg-SST-L2/nacaAirfoil/ref/state";
        fields          ( U rho thermo:mu phi rPseudoDeltaT k omega nut alphat );
        timeIndices     ( 1 2 3 9 10 );
    }
}
