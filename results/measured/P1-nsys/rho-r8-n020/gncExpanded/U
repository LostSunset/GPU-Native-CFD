//
// "0/U"
//
FoamFile
{
    version         2;
    format          ascii;
    class           volVectorField;
    object          U;
}

Uinlet          ( 250 0 0 );

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 250 0 0 );

boundaryField
{
    freestream
    {
        type            freestreamVelocity;
        freestreamValue uniform ( 250 0 0 );
        value           uniform ( 250 0 0 );
    }
    wall
    {
        type            noSlip;
    }
    cyclic
    {
        type            cyclic;
    }
    cyclicAMI
    {
        type            cyclicAMI;
        value           uniform ( 250 0 0 );
    }
    cyclicACMI
    {
        type            cyclicACMI;
        value           uniform ( 250 0 0 );
    }
    cyclicSlip
    {
        type            cyclicSlip;
    }
    empty
    {
        type            empty;
    }
    nonuniformTransformCyclic
    {
        type            nonuniformTransformCyclic;
    }
    processor
    {
        type            processor;
    }
    processorCyclic
    {
        type            processorCyclic;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
    symmetry
    {
        type            symmetry;
    }
    wedge
    {
        type            wedge;
    }
    overset
    {
        type            overset;
    }
}
