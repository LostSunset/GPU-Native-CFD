FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          T;
}

U               ( 600 148.16 0 );

p               100000;

T               300;

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 300;

boundaryField
{
    "(inlet_1|outlet_2)"
    {
        type            characteristicFarfieldTemperature;
        U               ( 600 148.16 0 );
        p               100000;
        T               300;
        value           uniform 300;
    }
    symplane_3
    {
        type            empty;
    }
    wall_4
    {
        type            characteristicWallTemperature;
        value           uniform 300;
    }
}
