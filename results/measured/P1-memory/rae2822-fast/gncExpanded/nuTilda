//
// "0/nuTilda"
//
FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    location        "0";
    object          nuTilda;
}

dimensions      [ 0 2 -1 0 0 0 0 ];

internalField   uniform 4.3999999999999999e-05;

boundaryField
{
    airfoil
    {
        type            boundaryCorrectedFixedValue;
        value           uniform 0;
    }
    "(farfield|outlet1|outlet2)"
    {
        type            inletOutlet;
        value           uniform 4.3999999999999999e-05;
        inletValue      uniform 4.3999999999999999e-05;
    }
    "(back|front)"
    {
        type            empty;
    }
    "(intPatch1|intPatch2)"
    {
        type            zeroGradient;
    }
}
