        p               100000;
        T               300;
        value           uniform ( 600 148.16 0 );
    }
    symplane_3
    {
        type            empty;
    }
    wall_4
    {
        type            boundaryCorrectedFixedValue;
        value           uniform ( 0 0 0 );
    }
