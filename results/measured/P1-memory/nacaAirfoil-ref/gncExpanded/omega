FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    location        "0";
    object          omega;
}

dimensions      [ 0 0 -1 0 0 0 0 ];

internalField   uniform 1900000;

boundaryField
{
    wall_4
    {
        type            omegaWallFunction;
        value           uniform 100000000;
    }
    "(inlet_1|outlet_2)"
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    1.0000000000000001e-05;
        value           uniform 1900000;
    }
    "(symplane_3)"
    {
        type            empty;
    }
}
