//
// "0/alphat"
//
FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    location        "0";
    object          alphat;
}

dimensions      [ 1 -1 -1 0 0 0 0 ];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    freestream
    {
        type            calculated;
        value           uniform 0;
    }
    inviscidWall
    {
        type            calculated;
        value           uniform 0;
    }
    viscousWall
    {
        type            fixedValue;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}
