//
// "constant/thermophysicalProperties"
//
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          thermophysicalProperties;
}

thermoType
{
    type            hePsiThermo;
    mixture         pureMixture;
    transport       sutherland;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       28.899999999999999;
    }
    thermodynamics
    {
        Cp              1005;
        Hf              0;
    }
    transport
    {
        As              1.4584000000000001e-06;
        Ts              110.33;
    }
}
