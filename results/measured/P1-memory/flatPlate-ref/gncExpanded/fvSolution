//
// "system/fvSolution"
//
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}

solvers
{
    nuTilda
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       9.9999999999999995e-07;
        relTol          0.01;
        minIter         1;
    }
}

relaxationFactors
{
    equations
    {
        nuTilda         0.5;
    }
}

flowSolver
{
    solver          GMRES;
    GMRES
    {
        inviscidJacobian LaxFriedrichs;
        viscousJacobian laplacian;
        preconditioner  LUSGS;
        maxIter         20;
        nKrylov         8;
        solverTolRel    0.10000000000000001 ( 0.10000000000000001 0.10000000000000001 0.10000000000000001 ) 0.10000000000000001;
    }
}

pseudoTime
{
    pseudoTol       1e-08 ( 1e-08 1e-08 1e-08 ) 1e-08;
    pseudoCoNum     10;
    pseudoCoNumMax  200;
    localTimestepping true;
}
