default         bounded dualTime rPseudoDeltaT steadyState;
startFrom       startTime;
startTime       0;
endTime         200;
deltaT          1;
writeControl    timeStep;
writeInterval   100;
writeFormat     binary;
writePrecision  17;
forces=forces
functions
{
    forces
    {
        type            forces;
        libs            ( "libforces.so" );
        patches         ( viscousWall );
        rhoName         rho;
        UName           U;
        log             off;
        writeControl    timeStep;
        writeInterval   1;
        CofR            ( 0 0 0 );
    }
}
