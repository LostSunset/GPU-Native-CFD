# Host settings read by scripts/build.sh and the verification and timing scripts.
# Copy this file, adjust the paths, and pass it with --host-env.
HOST_PROFILE=example
# OpenFOAM v2606 environment (wmake and headers); only needed for the reference tools
# in tools/ref and for running OpenFOAM/HiSA in the comparisons.
OPENFOAM_BASHRC=$HOME/OpenFOAM/OpenFOAM-v2606/etc/bashrc
# HiSA source tree with buildDefs.include (default: $WM_PROJECT_DIR/src/hisa).
#HISA_DIR=$HOME/hisa/src
NVCC=/usr/local/cuda/bin/nvcc
# 89: L40 / RTX 40xx, 86: RTX 30xx / A40, 80: A100, 90: H100
CUDA_ARCHS=89
GNC_ROOT=$HOME/gpu-native-cfd
# This checkout
SRC_DIR=$HOME/gpu-native-cfd/GPU-Native-CFD
BUILD_ROOT=$HOME/gpu-native-cfd/build
RUN_ROOT=$HOME/gpu-native-cfd/runs
# Prepared HiSA example cases (scripts/cases/)
CASE_ROOT=$HOME/gpu-native-cfd/cases
GPU_DEVICE=0
BUILD_JOBS=8
