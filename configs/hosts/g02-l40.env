# 主機設定：g02（主要環境；使用者 2026-10-22「都以 g02 為首要」）。
# Ubuntu 24.04.5、2x AMD EPYC 9684X、4x NVIDIA L40（sm_89）。
# 主機與使用者的大型 MPI run、GPU0–2 的 PPO 共用；本專案只用 GPU3。
# 工具鏈：/usr/bin/cmake 3.28.3、/usr/local/cuda/bin/nvcc 13.2（不在 PATH）、
# g++ 13.3；Atlas OpenFOAM v2606.0.2 runtime（含 wmake 與標頭）。
HOST_PROFILE=g02-l40
OPENFOAM_BASHRC=/opt/atlas-openfoam/current/OpenFOAM-v2606/etc/bashrc
NVCC=/usr/local/cuda/bin/nvcc
CUDA_ARCHS=89
GNC_ROOT=/ssd/sclin/gpu-native-cfd
SRC_DIR=/ssd/sclin/gpu-native-cfd/GPU-Native-CFD
BUILD_ROOT=/ssd/sclin/gpu-native-cfd/build
RUN_ROOT=/ssd/sclin/gpu-native-cfd/runs
CASE_ROOT=/home/sclin/hisa-gpu-research-cases
GPU_DEVICE=3
BUILD_JOBS=8
